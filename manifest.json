{
  "manifest_version": 3,
  "name": "Tab Rot!",
  "version": "1.0.0",
  "description": " tabs rot ",

  "icons": {
    "16": "icons/toolbar/16.png",
    "32": "icons/toolbar/32.png",
    "48": "icons/toolbar/48.png",
    "128": "icons/toolbar/128.png"
  },

  "action": {
    "default_title": "Tab Rot — click to view stats",
    "default_popup": "stats/stats.html",
    "default_icon": {
      "16": "icons/toolbar/16.png",
      "32": "icons/toolbar/32.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "sessions"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/**/*.png", "icons/**/*.svg"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
  "gecko": {
    "id": "null",
    "strict_min_version": "116.0"
  }
}
}