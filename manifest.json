{
  "manifest_version": 2,
  "name": "tab rot",
  "version": "2.0",
  "description": "tabs visually decay when left unvisited",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "http://*/*",
    "https://*/*"
  ],
  "browser_action": {
    "default_popup": "index.html",
    "default_title": "tab rot"
  },
  "background": {
    "scripts": ["bg.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}